# ============================================================
# Database
# ============================================================
DB_URL=jdbc:postgresql://<host>:5432/<database>
DB_USERNAME=<username>
DB_PASSWORD=<password>

# ============================================================
# GROQ - Resume Upload / Semantic Resume Analysis
# ============================================================
# The SAME Groq key is used by both models below.
GROQ_API_KEY=<groq-api-key>
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Resume analysis model
RESUME_AI_MODEL=openai/gpt-oss-120b
RESUME_AI_TEMPERATURE=0.1
RESUME_AI_MAX_TOKENS=4096

# ============================================================
# GROQ - AI Career Agent / Job AI
# ============================================================
QWEN_AGENT_MODEL=qwen/qwen3.8-27b
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=4096

# ============================================================
# Gemini - Embeddings / PGVector
# ============================================================
GEMINI_API_KEY=<gemini-api-key>
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ============================================================
# Supabase storage
# ============================================================
STORAGE_TYPE=supabase
SUPABASE_URL=<supabase-url>
SUPABASE_SERVICE_KEY=<supabase-service-key>
SUPABASE_RESUME_BUCKET=Resumes

# ============================================================
# SerpApi Job Search
# ============================================================
SERPAPI_API_KEY=<serpapi-api-key>
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_JOBS_ENGINE=google_jobs
SERPAPI_JOBS_LISTING_ENGINE=google_jobs_listing
SERPAPI_LANGUAGE=en
SERPAPI_COUNTRY=in
SERPAPI_TIMEOUT_SECONDS=20

SPRING_PROFILES_ACTIVE=prod
