# Single API Gateway entry point.
# Local development:
VITE_API_BASE_URL=http://localhost:8080
VITE_INTERVIEW_WS_URL=ws://localhost:8080/ws/interviews

# For production, set the same variables in your hosting provider's environment
# to your deployed API Gateway HTTPS and WSS URLs, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_INTERVIEW_WS_URL=wss://api.yourdomain.com/ws/interviews
